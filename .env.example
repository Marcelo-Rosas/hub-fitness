# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your-gemini-api-key"
# Modelo Gemini (Flash 3.6)
GEMINI_MODEL="gemini-3.6-flash"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Google OAuth (Drive)
# Use um Client ID do tipo "Aplicativo da Web" no Google Cloud Console
# com origem autorizada http://localhost:3000 para o login no browser.
GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxx"
GOOGLE_PROJECT_ID="your-project-id"
VITE_GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"

# =========================================================
# PUCOMEX / Portal Único Siscomex (M18)
# Docs: https://docs.portalunico.siscomex.gov.br/
# Auth: https://docs.portalunico.siscomex.gov.br/introducao-api-publica/
# Ambientes: https://docs.portalunico.siscomex.gov.br/ambientes/
# =========================================================
# validacao | producao | homologacao
PUCOMEX_ENV="validacao"
# Role-Type oficial (3PL depositário = DEPOSIT)
PUCOMEX_ROLE_TYPE="DEPOSIT"
# Caminho absoluto do certificado A1 (.pfx / .p12) ICP-Brasil — se exportável
PUCOMEX_CERT_PFX_PATH=""
PUCOMEX_CERT_PASSWORD=""
# Thumbprint Windows CurrentUser\My (preferido quando A1 não exportável)
# VECTRA HUB LTDA:62.188.748/0001-17
PUCOMEX_CERT_THUMBPRINT="73AD1B836553434CCA2E753F6866ADC9BE629458"
PUCOMEX_USE_VECTRA_HUB_CERT="true"
# Rótulo exibido no M18 (não vai ao Portal)
PUCOMEX_CNPJ_LABEL="VECTRA HUB LTDA:62.188.748/0001-17"
# true = usa mTLS quando PFX existir; false = força DEMO
PUCOMEX_LIVE="true"
# Apenas diagnóstico local — não use em produção
# PUCOMEX_TLS_INSECURE="false"
# Opcional: override da base URL
# PUCOMEX_BASE_URL="https://val.portalunico.siscomex.gov.br"

# =========================================================
# Postgres
# Operator (M12/M14 price/contracts): OPERATOR_DATABASE_URL
# Comex Client (M18): DATABASE_URL ou COMEX — NÃO misturar Operator
# Sem URL → SQLite local (comex + intranet).
# =========================================================
# OPERATOR_DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
# DATABASE_URL="postgresql://..."   # só Client/Comex DB — nunca o Operator
COMEX_DOCS_ROOT="D:\\Comex"
# COMEX_DB_PATH="data/comex.sqlite"
# COMEX_CLIENT_SLUG="konnen"

# =========================================================
# Supabase — Operator
# Browser: só URL + publishable. Secret nunca com prefixo VITE_.
# Schema intranet NÃO entra na Data API (PostgREST).
# =========================================================
# Browser (Vite) — nunca secret
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Express — Operator API (service role / secret)
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_SCHEMA_INTRANET="intranet"
# Prefer OPERATOR_DATABASE_URL acima (pg direto). DATABASE_URL = Client.

# =========================================================
# Intranet — aprovação RFQ + e-mail ao fornecedor / assignee
# Sem INTRANET_EMAIL_LIVE=true o disparo é simulado (não sai da máquina).
# Links /approve/:token usam APP_URL (prod: https://hub.vectracargo.com.br).
# =========================================================
# INTRANET_DB_PATH="data/intranet.sqlite"
# INTRANET_EMAIL_LIVE="false"
# RESEND_API_KEY=""
# RESEND_FROM="HUB-FITNESS Compras <compras@hubfitness3pl.com.br>"
